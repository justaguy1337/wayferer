# Copy this file to backend.env and fill in your keys.
# backend.env is gitignored — never commit real keys.

# --- LLM (Google Gemini) ---
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Cheapest current Flash-tier model with a 1M-token context window
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Places (Geoapify) ---
GEOAPIFY_API_KEY=

# --- Routing (TomTom) ---
TOMTOM_API_KEY=

# --- Weather (OpenWeather) ---
OPENWEATHER_API_KEY=

# --- Flights (Duffel) ---
# Free instant signup, no approval needed: app.duffel.com/join -> Developers -> Access tokens
# Test-mode keys start with "duffel_test_" and return sandbox data at no cost.
DUFFEL_API_KEY=

# --- Hotels (LiteAPI) ---
# Free instant sandbox signup, no approval needed: liteapi.travel -> Developer -> API Keys
LITEAPI_KEY=

# --- Currency (Frankfurter) ---
# No key required — https://www.frankfurter.app

# --- Web search (events / travel requirements) ---
# No key required — uses the duckduckgo-search library

# --- Server ---
HOST=0.0.0.0
PORT=8000
# (CORS is wide open in main.py — this is a local, single-user app)

# --- Storage ---
DATABASE_PATH=./travel_agent.db
